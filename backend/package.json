  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "type": "commonjs",
  "overrides": {
    "qs": "^6.17.0",
    "exceljs": {
      "uuid": "$uuid"
