PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/eams_db
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email (SendGrid or SMTP)
EMAIL_FROM=noreply@entrynex.lk
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

GOOGLE_API_KEY=your-google-api-key

# Admin seed account
SEED_ADMIN_EMAIL=admin@entrynex.com
SEED_ADMIN_PASSWORD=

# Payment Gateway (PayHere)
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=your-payhere-secret

# Azure Blob Storage Configuration
# Required for file uploads (photos, documents, etc.)
# Get connection string from Azure Portal -> Storage Account -> Access Keys -> Connection string
# Container must be created in Azure Blob Storage with appropriate access level (public or private)
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER=entrynex

# Twilio SMS Service
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
SMS_RATE_WINDOW_MS=900000
SMS_RATE_LIMIT_PER_WINDOW=5

# SendGrid (Advanced Email Templates)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FINAL_CONFIRMATION_TEMPLATE_ID=your-template-id-1
SENDGRID_BUYER_SUMMARY_TEMPLATE_ID=your-template-id-2

# Application URLs
BACKEND_URL=http://localhost:5000

# Event Support Details
EVENT_SUPPORT_EMAIL=support@entrynex.lk
EVENT_SUPPORT_PHONE=+94 11 234 5678

# Production: exact HTTPS origins, comma-separated. Set proxy hops only for a trusted proxy.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# AI is disabled unless all three are configured. Choose a model available to your account.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Vercel production setup
CRON_SECRET=
AZURE_PRIVATE_STORAGE_CONTAINER=
ADMIN_EMAIL=
ADMIN_PASSWORD=
